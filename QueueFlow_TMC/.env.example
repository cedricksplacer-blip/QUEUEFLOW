APP_NAME="QueueFlow TMC"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Production MUST set APP_DEBUG=false (never expose exception pages publicly).
APP_URL=http://192.168.1.154:8000

# ==========================================
# LAN access (Flutter app -> this PC, development only)
# ==========================================
# The address the Android app dials over the SAME Wi-Fi. Edit this one value
# when the PC's LAN IP changes, then run:
#   php artisan serve --host=0.0.0.0 --port=8000
# `localhost` / `127.0.0.1` are wrong here: on a phone they mean the phone.
# A private LAN address is NOT reachable from a different Wi-Fi or mobile
# data - that needs a hosted production server (see DEPLOYMENT.md),
# NOT a change to this line.
LAN_SERVER_URL=http://192.168.1.154:8000

# ==========================================
# Public HTTPS endpoint (different Wi-Fi / mobile data)
# ==========================================
# Only needed when the API is deployed to a public production server.
# There is no tunnel configured in this project: remote access requires
# hosting the app on a server with HTTPS, then pointing the Flutter app
# at it with:
#   flutter run --dart-define=API_BASE_URL=https://<your-public-host>/api
# Never invent a host here - use the real production hostname.
#APP_URL_PUBLIC=https://api.example.edu
#CORS_ALLOWED_ORIGINS=https://example.edu,https://api.example.edu
#TRUSTED_PROXIES=*
#SESSION_SECURE_COOKIE=true
#SESSION_SAME_SITE=lax
#SANCTUM_STATEFUL_DOMAINS=example.edu

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# QueueFlow TMC uses MySQL / MySQL Server.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=queueflow_tmc
DB_USERNAME=root
DB_PASSWORD=

# Tests use a dedicated database (see phpunit.xml.dist): queueflow_tmc_test


BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@tmc.edu"
MAIL_FROM_NAME="${APP_NAME}"

# ==========================================
# Real student email delivery (Gmail SMTP)
# ==========================================
# Password recovery mails the 6-digit code to the email address the admin
# saved on the student's account. The default above (`log`) only writes mail
# to the Laravel log, so no student ever receives a code. For real delivery,
# set these five values from the environment (never commit secrets):
#
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME="your-campus-address@gmail.com"
#   MAIL_PASSWORD="your-16-char-app-password"
#   MAIL_ENCRYPTION=tls
#   MAIL_FROM_ADDRESS="your-campus-address@gmail.com"
#   MAIL_FROM_NAME="QueueFlow TMC"
#
# Gmail requires a 16-character App Password (Google Account > Security >
# 2-Step Verification > App passwords), NOT the account password. The app
# password lives only in `.env` (which is git-ignored); `config/mail.php`
# reads it via `env()` and no source file hardcodes it. A mail failure
# returns HTTP 503 so the app never shows a success message unless the mail
# service has accepted the message for sending.
